<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/infoNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_viewer_info_name"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />
    <TextView
        android:id="@+id/infoNameValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/infoDimensionsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_viewer_info_dimensions"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />
    <TextView
        android:id="@+id/infoDimensionsValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/infoSizeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_viewer_info_size"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />
    <TextView
        android:id="@+id/infoSizeValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/infoDateLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_viewer_info_date"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />
    <TextView
        android:id="@+id/infoDateValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/infoPathLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_viewer_info_path"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />
    <TextView
        android:id="@+id/infoPathValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary" />
</LinearLayout>
